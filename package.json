{
  "name": "ai-api-gateway",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "description": "中文优先、面向个人自托管的多厂商 AI API Gateway",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream --filter @aigw/gateway --filter @aigw/web --filter @aigw/e2e dev",
    "build": "pnpm --filter @aigw/gateway build && pnpm --filter @aigw/web build",
    "start": "pnpm --filter @aigw/gateway start",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:scripts && pnpm -r --if-present test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "change-scope": "node scripts/change-scope.mjs",
    "evidence:select": "node scripts/select-evidence.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "knip": "knip --treat-config-hints-as-errors",
    "duplication": "jscpd --config .jscpd.json",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:generate": "pnpm --filter @aigw/gateway db:generate",
    "db:migrate": "pnpm --filter @aigw/gateway db:migrate",
    "db:bootstrap": "pnpm --filter @aigw/gateway db:bootstrap",
    "api:generate": "node scripts/openapi/generate-types.mjs",
    "api:generated:check": "node scripts/openapi/check-generated.mjs",
    "docs:bundle": "node scripts/docs/bundle-spec.mjs",
    "docs:module-graph": "node scripts/docs/generate-module-graph.mjs",
    "docs:module-graph:check": "node scripts/docs/generate-module-graph.mjs --check",
    "docs:check": "node scripts/docs/check-docs.mjs",
    "version:set": "node scripts/version/set-project-version.mjs",
    "verify:project-version": "node scripts/verify/project-version.mjs",
    "release:assets": "node scripts/release/create-assets.mjs",
    "verify:typescript-version": "node scripts/verify/typescript-version.mjs",
    "verify:boundaries": "node scripts/verify/boundaries.mjs",
    "verify:imports": "node scripts/verify/imports.mjs",
    "verify:agent-assets": "node scripts/verify/agent-assets.mjs",
    "verify:protocol-invariants": "pnpm --filter @aigw/gateway test:protocol",
    "verify:secret-safety": "node scripts/verify/secret-safety.mjs",
    "verify:migrations": "node scripts/verify/migrations.mjs",
    "verify:runtime-invariants": "node scripts/verify/runtime-invariants.mjs",
    "verify:decisions": "node scripts/verify/decision-notes.mjs",
    "verify:gate-contract": "node scripts/verify/gate-contract.mjs",
    "check:quick": "node scripts/check.mjs quick",
    "check:control": "node scripts/check.mjs control",
    "check:data": "node scripts/check.mjs data",
    "check:protocol": "node scripts/check.mjs protocol",
    "check:db": "node scripts/check.mjs db",
    "check:web": "node scripts/check.mjs web",
    "check:e2e": "node scripts/check.mjs e2e",
    "check:artifact": "node scripts/check.mjs artifact",
    "check:docs": "node scripts/check.mjs docs",
    "hygiene": "node scripts/check.mjs hygiene",
    "check:all": "node scripts/check.mjs all",
    "check:ci": "node scripts/check.mjs ci",
    "check:ci:static": "node scripts/check.mjs ci-static",
    "check:ci:core": "node scripts/check.mjs ci-core",
    "check:ci:protocol": "node scripts/check.mjs ci-protocol",
    "check:ci:artifact": "node scripts/check.mjs ci-artifact",
    "postinstall": "node scripts/install-lefthook.mjs",
    "ui:info": "shadcn info --cwd apps/web --json",
    "ui:add": "shadcn add --cwd apps/web",
    "toolchain:shadcn:apply": "shadcn apply --cwd apps/web --preset base-nova",
    "toolchain:eslint:init": "pnpm dlx @antfu/eslint-config@9.3.0",
    "verify:toolchain-baseline": "node scripts/verify/toolchain-baseline.mjs",
    "verify:toolchain-official": "node scripts/verify/toolchain-official.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "eslint": "10.8.1",
    "eslint-plugin-boundaries": "7.1.0",
    "typescript": "6.0.3",
    "openapi-typescript": "catalog:",
    "lefthook": "catalog:",
    "knip": "catalog:",
    "jscpd": "catalog:",
    "@antfu/eslint-config": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "semver": "catalog:",
    "shadcn": "catalog:"
  }
}
