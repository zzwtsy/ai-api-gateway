  "eslint": {
    "initializer": "@antfu/eslint-config",
    "version": "9.3.0",
    "react": true,
    "jsxA11y": true,
    "projectRules": [
      "gateway dependency boundaries",
      "control-plane feature isolation",
      "web feature isolation",
      "complexity and file-size ratchets"
    ]
  },
  "vite": {
    "template": "react-ts",
    "typescriptFaces": [
      "apps/web/tsconfig.app.json",
      "apps/web/tsconfig.node.json"
    ],
    "router": {
      "mode": "file-based",
      "routesDirectory": "apps/web/src/routes",
      "generatedRouteTree": "apps/web/src/routeTree.gen.ts",
      "plugin": "@tanstack/router-plugin",
      "pluginVersion": "1.168.23",
      "autoCodeSplitting": true
    }
  },
  "activation": {
    "requiresRegistryAccess": true,
    "requiresNode": "24.x",
    "requiresPnpm": "11.x",
    "requiredGeneratedFiles": [
      "pnpm-lock.yaml",
      "apps/web/src/api/schema.d.ts",
      "apps/web/src/routeTree.gen.ts"
    ]
  },
  "openapiClient": {
    "schema": "apps/web/src/api/schema.d.ts",
    "typeGenerator": "openapi-typescript",
    "transport": "openapi-fetch",
    "queryAdapter": "openapi-react-query",
    "runtimeDirectory": "apps/web/src/lib/api-runtime",
    "serverStateOwner": "@tanstack/react-query"
  }
