{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ai-api-gateway-shadcn-product-ux",
  "version": "0.1.0-alpha.3",
  "mode": "light",
  "color": {
    "background": "#ffffff",
    "foreground": "#0a0a0a",
    "surface": "#ffffff",
    "surfaceSubtle": "#fafafa",
    "sidebar": "#fafafa",
    "muted": "#f5f5f5",
    "mutedForeground": "#737373",
    "border": "#e5e5e5",
    "input": "#e5e5e5",
    "ring": "#a1a1a1",
    "primary": "#1447e6",
    "primaryForeground": "#eff6ff",
    "destructive": "#e7000b",
    "semantic": {
      "success": {
        "foreground": "#004726",
        "background": "oklch(0.696 0.17 162.48 / 10%)",
        "border": "oklch(0.696 0.17 162.48 / 20%)"
      },
      "warning": {
        "foreground": "#743800",
        "background": "oklch(0.769 0.188 70.08 / 10%)",
        "border": "oklch(0.769 0.188 70.08 / 20%)"
      },
      "danger": {
        "foreground": "#e7000b",
        "background": "oklch(0.577 0.245 27.325 / 10%)",
        "border": "transparent"
      },
      "info": {
        "foreground": "#1d4ed8",
        "background": "#eff6ff",
        "border": "#bfdbfe"
      },
      "purple": {
        "foreground": "#7e22ce",
        "background": "#faf5ff",
        "border": "#e9d5ff"
      }
    }
  },
  "radius": {
    "shell": "12px",
    "default": "10px",
    "small": "6px",
    "pill": "999px"
  },
  "shadow": {
    "xs": "0 1px 2px rgb(0 0 0 / 0.035)",
    "sm": "0 1px 3px rgb(0 0 0 / 0.055), 0 1px 2px rgb(0 0 0 / 0.03)",
    "dialog": "0 24px 60px rgb(0 0 0 / 0.20)",
    "sheet": "-16px 0 44px rgb(0 0 0 / 0.14)"
  },
  "layout": {
    "shellOuterGap": "8px",
    "sidebarExpanded": "256px",
    "sidebarCollapsed": "48px",
    "topbarHeight": "56px",
    "pageGutterDesktop": "24px",
    "pageGutterMedium": "20px",
    "pageGutterCompact": "16px",
    "pageTopPadding": "22px",
    "pageBottomPadding": "32px",
    "requestMasterMin": "620px",
    "requestInspectorMin": "390px",
    "connectionDirectory": "300px",
    "settingsNavigation": "220px",
    "settingsContentMax": "760px",
    "sheetDefault": "500px",
    "sheetWide": "640px"
  },
  "control": {
    "defaultHeight": "34px",
    "smallHeight": "30px",
    "iconDefault": "34px",
    "iconSmall": "30px"
  },
  "table": {
    "headerHeight": "35px",
    "rowHeight": "42px",
    "fontSize": "12px",
    "headerFontSize": "10px"
  },
  "typography": {
    "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei, sans-serif",
    "monoFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "pageTitle": {
      "size": "22px",
      "lineHeight": "30px",
      "weight": 680,
      "tracking": "-0.025em"
    },
    "editorTitle": {
      "size": "18px",
      "lineHeight": "26px",
      "weight": 670
    },
    "entityTitle": {
      "size": "16px",
      "lineHeight": "23px",
      "weight": 660
    },
    "cardTitle": {
      "size": "13px",
      "lineHeight": "19px",
      "weight": 650
    },
    "body": {
      "size": "14px",
      "lineHeight": "21px",
      "weight": 400
    },
    "control": {
      "size": "12px",
      "lineHeight": "16px",
      "weight": 560
    },
    "helper": {
      "size": "11px",
      "lineHeight": "17px",
      "weight": 400
    },
    "micro": {
      "size": "10px",
      "lineHeight": "14px",
      "weight": 400
    }
  },
  "breakpoint": {
    "wide": "1600px",
    "desktop": "1440px",
    "minimumCommitted": "1280px",
    "compactDesktop": "1024px"
  },
  "motion": {
    "fast": "80ms",
    "default": "120ms",
    "overlay": "150ms",
    "sheet": "180ms",
    "easing": "ease-out"
  }
}
