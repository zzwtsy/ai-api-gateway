{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedUsage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "inputTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "outputTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "reasoningTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cacheReadTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cacheWriteTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "audioInputTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "audioOutputTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "totalTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source": {
      "enum": [
        "reported",
        "calculated",
        "estimated",
        "unknown"
      ]
    },
    "complete": {
      "type": "boolean"
    }
  },
  "required": [
    "source",
    "complete"
  ]
}
