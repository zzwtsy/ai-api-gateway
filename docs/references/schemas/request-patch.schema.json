{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RequestPatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location",
    "path",
    "mode",
    "value"
  ],
  "properties": {
    "location": {
      "enum": [
        "header",
        "query",
        "body"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "default_if_absent",
        "force",
        "reject_on_conflict"
      ]
    },
    "value": {},
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "location": {
            "const": "body"
          }
        }
      },
      "then": {
        "properties": {
          "path": {
            "pattern": "^/"
          }
        }
      }
    }
  ]
}
