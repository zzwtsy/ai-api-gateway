{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderCredentialConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "accountId",
    "name",
    "kind",
    "secretRef"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "accountId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "api_key",
        "bearer_token",
        "custom_header_set"
      ]
    },
    "secretRef": {
      "type": "string",
      "pattern": "^(env|file|secret)://"
    },
    "status": {
      "enum": [
        "unverified",
        "healthy",
        "cooldown",
        "auth_failed",
        "unavailable",
        "disabled"
      ],
      "default": "unverified"
    },
    "endpointBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpointId"
        ],
        "properties": {
          "endpointId": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "default": 100
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}
