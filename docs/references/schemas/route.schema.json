{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteRuleConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "scope",
    "protocol",
    "matcher",
    "targets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "client",
            "harness",
            "global"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "protocol": {
      "enum": [
        "openai_chat",
        "openai_responses",
        "anthropic_messages"
      ]
    },
    "matcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pattern"
      ],
      "properties": {
        "type": {
          "enum": [
            "exact",
            "prefix",
            "glob",
            "regex"
          ]
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "priority": {
      "type": "integer",
      "default": 0
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "maxGatewayAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 2
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "endpointId",
          "providerModelBindingId"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "endpointId": {
            "type": "string"
          },
          "providerModelBindingId": {
            "type": "string"
          },
          "accountSelectionMode": {
            "enum": [
              "automatic",
              "pinned_account",
              "pinned_credential"
            ],
            "default": "automatic"
          },
          "accountSelectorId": {
            "type": [
              "string",
              "null"
            ]
          },
          "requestTimeoutMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1000,
            "maximum": 7200000
          },
          "patches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "location",
                "path",
                "mode",
                "value"
              ],
              "properties": {
                "location": {
                  "enum": [
                    "header",
                    "query",
                    "body"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "mode": {
                  "enum": [
                    "default_if_absent",
                    "force",
                    "reject_on_conflict"
                  ]
                },
                "value": {},
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "location": {
                        "const": "body"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "path": {
                        "pattern": "^/"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
