{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayClientConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "harnessProfile",
    "allowedProtocols"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "harnessProfile": {
      "enum": [
        "codex",
        "claude-code",
        "pi",
        "generic-openai-chat",
        "generic-openai-responses",
        "generic-anthropic"
      ]
    },
    "allowedProtocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "openai_chat",
          "openai_responses",
          "anthropic_messages"
        ]
      }
    },
    "allowedModelPatterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dailyCostLimit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "monthlyCostLimit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "status": {
      "enum": [
        "active",
        "disabled"
      ],
      "default": "active"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretRef": {
          "type": "string",
          "pattern": "^(env|file|secret)://"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
