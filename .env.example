NODE_ENV=development
PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgresql://aigw:aigw@127.0.0.1:5432/aigw
STORAGE_DRIVER=postgres

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3001
WEB_ORIGIN=http://127.0.0.1:5173

# 仅非生产环境使用的控制面快捷令牌；NODE_ENV=production 时忽略。
DEV_ADMIN_TOKEN=admin_dev_local

# Bootstrap 数据面配置。路由目标在里程碑 B 前仍由环境变量固定。
# PostgreSQL 首次启动只在对应 ID 不存在时创建耐久客户端、HMAC Key 与加密 Credential；后续轮换以数据库为准，不会被环境变量覆盖。
GATEWAY_CLIENT_KEY=gw_dev_local_key
GATEWAY_KEY_PEPPER=replace-with-a-random-pepper
# Provider Credential 使用 AES-256-GCM 加密。Keyring 值是 Key ID 到 32-byte Base64 Key 的 JSON。
# 轮换时先加入新 Key，再切换 Active Key；旧密文重加密完成前保留旧 Key。
PROVIDER_SECRET_ACTIVE_KEY_ID=development-v1
PROVIDER_SECRET_KEYRING={"development-v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
PROVIDER_SECRET_FINGERPRINT_PEPPER=replace-with-a-provider-fingerprint-pepper
BOOTSTRAP_PROVIDER_BASE_URL=http://127.0.0.1:4010
BOOTSTRAP_PROVIDER_API_KEY=mock-provider-key
BOOTSTRAP_CONNECTION_ID=bootstrap-provider-connection
BOOTSTRAP_PROVIDER_CREDENTIAL_ID=bootstrap-provider-credential
ROUTING_SNAPSHOT_VERSION=1

OBSERVER_MAX_BUFFER_BYTES=65536
UPSTREAM_CONNECTIONS=8
UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_HEADERS_TIMEOUT_MS=30000
UPSTREAM_BODY_IDLE_TIMEOUT_MS=60000
# 仅供 `pnpm db:bootstrap` 使用。
BOOTSTRAP_ADMIN_NAME=Owner
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-production
