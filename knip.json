{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": [
        "eslint.config.mjs",
        "scripts/check.mjs",
        "scripts/change-scope.mjs",
        "scripts/select-evidence.mjs",
        "scripts/install-lefthook.mjs",
        "scripts/artifact/*.mjs",
        "scripts/docs/*.mjs",
        "scripts/openapi/*.mjs",
        "scripts/verify/*.mjs"
      ],
      "project": [
        "eslint.config.mjs",
        "scripts/**/*.mjs"
      ]
    },
    "apps/gateway": {
      "entry": [
        "src/index.ts",
        "src/commands/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "*.config.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "*.config.ts"
      ],
      "ignoreIssues": {
        "src/components/ui/**": [
          "exports",
          "types"
        ],
        "src/api/schema.d.ts": [
          "exports",
          "types"
        ],
        "src/routeTree.gen.ts": [
          "exports",
          "types"
        ]
      }
    },
    "apps/e2e": {
      "entry": [
        "src/mock-provider.ts",
        "tests/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "playwright.config.ts"
      ]
    }
  },
  "ignore": [
    ".artifacts/**",
    "apps/gateway/drizzle/**"
  ]
}
