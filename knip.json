{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "includeEntryExports": true,
  "ignoreIssues": {
    "apps/web/src/components/ui/**": [
      "exports",
      "types"
    ],
    "apps/web/src/api/schema.d.ts": [
      "exports",
      "types"
    ],
    "apps/web/src/routeTree.gen.ts": [
      "exports",
      "types"
    ]
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/artifact/*.ts",
        "scripts/docs/*.ts",
        "scripts/evidence/read-git-source-state.ts",
        "scripts/openapi/*.ts",
        "scripts/verify/*.ts"
      ],
      "project": [
        "scripts/**/*.ts"
      ]
    },
    "apps/gateway": {
      "entry": [
        "src/commands/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "*.config.ts"
      ]
    },
    "apps/web": {
      "project": [
        "src/**/*.{ts,tsx}",
        "*.config.ts"
      ]
    },
    "apps/e2e": {
      "entry": [
        "tests/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    }
  }
}
